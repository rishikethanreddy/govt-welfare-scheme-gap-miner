# Copy to .env and adjust. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────
# Development: SQLite file in the project root.
DATABASE_URL=sqlite:///./welfare_awareness.db
# Production: PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg2://gapminer:CHANGE_ME@localhost:5432/welfare_awareness

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | test | production
DEBUG=false
SQL_ECHO=false

# ── Security ──────────────────────────────────────────────────────────────
# Required for uploads, collection, source management and review (X-API-Key header).
# No default: leave empty to disable those actions entirely. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend (read by Next.js at build time) ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── NLP ───────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
NEAR_DUPLICATE_THRESHOLD=0.96
SIMILARITY_SEARCH_MIN=0.35
CLUSTER_MIN_SIZE=0               # 0 = derived from corpus size
MODELS_DIR=data/models

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_ROWS=50000
UPLOAD_DIR=data/uploads

# ── Collection ────────────────────────────────────────────────────────────
SCRAPER_USER_AGENT=WelfareAwarenessResearchBot/1.0 (+academic research; respects robots.txt)
SCRAPER_DEFAULT_DELAY=2.0        # minimum seconds between requests to one host
SCRAPER_DEFAULT_TIMEOUT=20
SCRAPER_MAX_RETRIES=2
SCRAPER_MAX_BYTES=5242880
COLLECTION_SOURCE_CONCURRENCY=2
SOURCE_FAILURE_PAUSE_THRESHOLD=3
AUTOPILOT_INTERVAL_HOURS=12
# Optional: enables the Kisan Call Centre (data.gov.in) source together with a resource_id in its config.
DATA_GOV_IN_API_KEY=
